// WHAT A CUSTOM GAME'S TOOLSET CAN AND CANNOT DO
//
// It can ADD a tool. It CANNOT override one the base content already declares:
// the first declaration wins and ours is loaded after.
//
// MEASURED. The game log prints the class each uuid actually resolved to, and
// across every Server Works session it printed the BASE class, never ours:
//
//   Created Tool 18 of type {8f190ce2-3a59-423e-8483-a7aa67bd5bc0(SurvivalLift)}
//
// while this file was asking for class Lift. Same for 6993e5df(ClayRifle) and
// a2a2bb33(PotatoLauncher). Meanwhile the nugdupS entry below -- a uuid nothing
// else declares -- resolves exactly as written. Adding works, overriding does
// not, and those two facts together are what tell the cases apart.
//
// So the entries that pointed 6993e5df at GuardedClayRifle and a2a2bb33 at
// GuardedPotatoLauncher are gone: they never ran. What actually stops those
// tools is the client-side forceTool guard in Game.client_onFixedUpdate.
//
// (Line comments really are legal here -- Data/Tools/ToolSets/tools.json:44
// uses them itself.)

{
	"toolList": [

		// NO LIFTS ARE ADDED HERE ANY MORE.
		//
		// Two were, and both are gone:
		//
		//   5cc12f03  the creative lift. Added because baseGameContent "Survival"
		//             never loads the creative tool index, so it was not in the
		//             game. It worked -- the log printed Created Tool ... (Lift) --
		//             but survival content already provides 8f190ce2, and the two
		//             are the same tool for every purpose that survives here:
		//             SurvivalLift is class( Lift ) with one live method and the
		//             rest of the file commented out, so it inherits all the
		//             carrying and raising. Adding ours put a second, identical
		//             lift in the menu.
		//   4c893da9  the Import Lift, added on the theory that the E-on-lift
		//             creations menu was blocked by something about the tool. It
		//             was not: that menu is engine-side and keyed on loaded
		//             content, and no lift in this game opens it. Importing is
		//             NOTlift's job now and this had nothing left to do.
		//
		// The survival lift stays because it is base content and cannot be removed.
		// It is host-gated by `hostlift`; see Settings.lua.

		// NOTLIFT -- the creations importer, and the answer to "I cant press E on
		// the lift to import stuff".
		//
		// "NOTlift will be clasified as ANYTHING but a lift" -- taken literally. The
		// class is a Sledgehammer subclass, it calls no lift binding at all, and it
		// is a uuid nothing else in the game declares, so it is an ADDITION and it
		// resolves to our class. See NotLift.lua for why the real lift cannot do
		// this and why the engine's own browser is borrowed instead.
		//
		// Preview renderable is the LIFT's, on purpose: whatever the class is called,
		// what this does for a player is "the lift menu", and a tool that does not
		// look like the thing it does is a tool nobody finds.
		{
			"uuid": "7b3d5c91-4a2e-4f88-9c17-2e6d0b5a13ff",
			"previewRenderable": "$GAME_DATA/Character/Char_Tools/char_lift_preview.rend",
			"previewRotation": [ 1, 0, 0, 0, 0, -1, 0, 1, 0 ],
			"script": { "class": "NotLift", "file": "$CONTENT_DATA/Scripts/NotLift.lua" }
		},

		// THE CLEANER, and the answer to "I want to be able to DELETE them when
		// pressing F while removing".
		//
		// F is `ForceBuild` -- MEASURED from the owner's own keybinds.json, where
		// it is key 70 -- and that action reaches Lua in exactly ONE place: the
		// third argument of a tool's client_onEquippedUpdate. No Game, World or
		// player script is handed key state at all, so a tool is the only thing
		// that can see F, and adding a tool is the only thing a Custom Game
		// toolset can do. Those two facts together are the whole design.
		//
		// A brand new uuid, so this is an ADDITION and will actually resolve to
		// our class -- see the note at the top of this file for why an override
		// would not have.
		{
			"uuid": "bbbb0cc8-5dd0-46e1-9299-8080c3cc80db",
			// Renderable and rotation both copied from the CREATIVE sledgehammer's
			// own entry (Data/Tools/ToolSets/tools.json, uuid ed185725) rather
			// than from the lift, because the rotation belongs to the renderable
			// -- the lift's matrix would draw this one on its side in the menu.
			//
			// The held models come from the class, not from here:
			// Sledgehammer:418 and :426 call setTpRenderables / setFpRenderables
			// themselves, and we inherit both.
			"previewRenderable": "$GAME_DATA/Character/Char_Tools/char_sledgehammer_preview.rend",
			"previewRotation": [ -1, 0, 0, 0, 0, 1, 0, 1, 0 ],
			"script": { "class": "CleanerTool", "file": "$CONTENT_DATA/Scripts/CleanerTool.lua" }
		},

		// THE FOCUS TOOL -- "search for nicknames that are curently on the
		// server. and when selected it will highlight them. so people can see
		// the focus person."
		//
		// Point at a player and click: everybody in the world gets a marker over
		// them. Point at nothing and click: the searchable player list opens.
		// Hold F and the focus is cleared.
		//
		// It is a tool rather than only a panel for one forced reason: F is
		// `ForceBuild` and reaches Lua ONLY as the third argument of a tool's
		// client_onEquippedUpdate. No Game, World or player script is handed key
		// state at all.
		//
		// Another new uuid, so this is an ADDITION and resolves to our class --
		// see the note at the top of this file for why an override would not.
		{
			"uuid": "f0c5a11e-7d3b-4c6a-9e21-5b8a4d0f9c33",
			// Sledgehammer preview and rotation, the same pair the Cleaner uses,
			// because this is a Sledgehammer subclass too and the rotation
			// matrix belongs to the renderable. The MENU icon is what tells the
			// three apart -- see mod/Gui/IconMap.xml.
			"previewRenderable": "$GAME_DATA/Character/Char_Tools/char_sledgehammer_preview.rend",
			"previewRotation": [ -1, 0, 0, 0, 0, 1, 0, 1, 0 ],
			"script": { "class": "FocusTool", "file": "$CONTENT_DATA/Scripts/FocusTool.lua" }
		},

		// The stale-mod canary. A uuid nothing else declares, so if it is in the
		// creative menu then mod content updates are reaching the game. It is
		// also the standing proof that adding a tool works.
		{
			"uuid": "748b6656-84b2-440f-8f4c-8cc7deeba63c",
			"previewRenderable": "$GAME_DATA/Character/Char_Tools/char_spudgun_preview.rend",
			"previewRotation": [ 1, 0, 0, 0, 0, -1, 0, 1, 0 ],
			"script": { "class": "PotatoRifle", "file": "$SURVIVAL_DATA/Scripts/game/tools/PotatoRifle.lua" }
		}
	]
}
